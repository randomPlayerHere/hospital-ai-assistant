# Copy to .env (make up does this and generates random secrets). Never commit .env.
# NOTE: no inline comments after values (docker compose env_file would treat them as part of the value).

# --- App ---
ENVIRONMENT=dev
SECRET_KEY=change-me-32+chars-random
# Fernet key: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=change-me-fernet-key
CORS_ORIGINS=http://localhost:3000
HOSPITAL_TIMEZONE=Asia/Kolkata

# --- Database ---
POSTGRES_DB=hospital
POSTGRES_USER=hospital_migrator
POSTGRES_PASSWORD=change-me
APP_DB_USER=hospital_app
APP_DB_PASSWORD=change-me-too
DATABASE_URL=postgresql+asyncpg://hospital_app:change-me-too@db:5432/hospital
MIGRATION_DATABASE_URL=postgresql+asyncpg://hospital_migrator:change-me@db:5432/hospital

# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: low | medium | high. Leave empty for models without effort support.
ANTHROPIC_EFFORT=
AI_ENABLED=true

# --- Storage (local | s3) ---
STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads
# For local S3 (MinIO):
# STORAGE_BACKEND=s3
# S3_BUCKET=hospital-docs
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadminpassword
# S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Email (console | smtp) ---
EMAIL_BACKEND=console
# For local SMTP (Mailpit):
# EMAIL_BACKEND=smtp
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Virus Scanning (ClamAV) ---
# Empty = in-memory EICAR scanner. In production or with clamav service:
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Ops ---
# Shared rate-limit counters across workers, e.g. redis://redis:6379/0 (prod compose sets it). Empty = in-process.
REDIS_URL=
SENTRY_DSN=
DOMAIN=localhost
